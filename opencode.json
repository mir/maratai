{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {},
  "formatter": {
    "uv-ruff-lint": {
      "extensions": [".py"],
      "command": ["uvx", "ruff", "check", "--fix", "$FILE"]
    },
    "uv-ruff-format": {
      "extensions": [".py"],
      "command": ["uvx", "ruff", "format", "$FILE"]
    },
  }
}
